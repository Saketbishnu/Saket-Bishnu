PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/saket-portfolio?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173

# Brevo Transactional Email REST API Configuration
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com
BREVO_SENDER_NAME="Your Name"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Authentication for Project Management
ADMIN_SECRET=your_secure_admin_secret_key
